<UserControl x:Class="FAA.WpfGui.Views.FlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      流程页 = webui.html「测试界面」运行区 + 流程表 + 知识库:
      流程下拉(/api/flows) + 运行(POST /api/run, mode 固定 use=webui.html:875) +
      流程表(流程名/文件) + 知识库(/api/kb 场景分组折叠树 + 分类 tag + 关闭按钮库)。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12" MaxWidth="900" HorizontalAlignment="Left">

            <!-- 运行单流程 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="运行单流程" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="FlowCombo" Width="280"
                                  ItemsSource="{Binding Flows}"
                                  SelectedItem="{Binding SelectedFlow, Mode=TwoWay}"
                                  DisplayMemberPath="Display"/>
                        <Button Content="运行" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Command="{Binding StartCommand}"/>
                    </StackPanel>
                    <TextBlock Text="流程运行在后台, 运行日志见「运行日志」页。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding RunStatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Foreground="{StaticResource OkBrush}"/>
                </StackPanel>
            </Border>

            <!-- 流程表 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="流程列表 (flows/*.json)" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding FlowTable}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding File}" Style="{StaticResource MutedText}"
                                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 知识库 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="知识库 (click_log.json)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding KbStatusText}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>

                    <!-- 场景分组折叠树 -->
                    <ItemsControl ItemsSource="{Binding KbScenes}" AlternationCount="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,2">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Run Text="{Binding ButtonCount, Mode=OneWay}" Foreground="{StaticResource OkBrush}"/>
                                                <Run Text=" 个按钮 · " Foreground="{StaticResource SubBrush}"/>
                                                <Run Text="{Binding CategoriesSummary, Mode=OneWay}" Foreground="{StaticResource SubBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Buttons}" Margin="14,2,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                                                        <Border Grid.Column="1" HorizontalAlignment="Left"
                                                                Background="#33373F" CornerRadius="3" Padding="6,1"
                                                                ToolTip="按钮分类">
                                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                                       Foreground="{StaticResource SubBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding RelText}"
                                                                   Foreground="{StaticResource OkBrush}" FontFamily="Consolas" FontSize="11"
                                                                   ToolTip="相对坐标/均值样本"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 关闭按钮库 -->
                    <ItemsControl ItemsSource="{Binding KbCloseButtons}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Left" Background="#4A2C2C"
                                                CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="关闭按钮" FontSize="11" Foreground="{StaticResource ErrBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Scene}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" Style="{StaticResource MutedText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding KbSummaryText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
