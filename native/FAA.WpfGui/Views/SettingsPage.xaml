<UserControl x:Class="FAA.WpfGui.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      设置页 = webui.html 右栏「连接设置 / 识别设置 / 界面设置」三卡片。
      契约6: 识别三项回显唯一来源 /api/daily; 每控件改动即时 set_config 并显示「已保存 ✓」。
      界面两项回显来自 /api/status(webui.html:447,490 同口径); 文本框编辑中不被状态轮询回显抢写。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="16,12">

            <!-- ======== 卡片一: 连接 ======== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="连接" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="连接配置" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConnConfig}" Style="{StaticResource RowValue}"/>
                        <TextBlock Grid.Row="1" Text="ADB 路径" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AdbPath}" Style="{StaticResource RowValue}"/>
                        <TextBlock Grid.Row="2" Text="连接地址" Style="{StaticResource RowLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectAddr}" Style="{StaticResource RowValue}"/>
                        <TextBlock Grid.Row="3" Text="连接状态" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding ConnStateText}" Style="{StaticResource DarkButton}"
                                    MinWidth="110" Command="{Binding ConnectCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="实机分辨率" Style="{StaticResource RowLabel}"
                                   ToolTip="screen=实机分辨率(adb 直读); 引擎工作区可能按 MAA 长边缩放, 相对坐标不受影响"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ResolutionText}" Style="{StaticResource RowValue}"/>
                        <!-- 批 21: tpltool 过渡期方案 —— 系统默认浏览器开 {当前baseurl}/tpltool(未连接兜底缺省口 8765) -->
                        <TextBlock Grid.Row="5" Text="模板标注工具" Style="{StaticResource RowLabel}"
                                   ToolTip="tpltool 过渡期方案: 原生标注页未建, 过渡期沿用服务端 web 标注页"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开模板标注工具" Style="{StaticResource DarkButton}"
                                    MinWidth="130" Command="{Binding OpenTplToolCommand}"/>
                            <TextBlock Text="在系统浏览器中打开（tpltool 过渡期方案）" Style="{StaticResource MutedText}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- A3: 关闭服务 —— 仅已连接(托管或外部实例)时可用; DialogService.Confirm 二次确认后 POST /api/shutdown
                             B3: 重启后端 —— 与关闭服务并排; 仅本窗口托管的服务可用, 调 FaaProcessHost.RestartAsync -->
                        <TextBlock Grid.Row="6" Text="服务控制" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="关闭服务" Style="{StaticResource DangerButton}"
                                    MinWidth="110" Command="{Binding ShutdownServiceCommand}"
                                    ToolTip="向服务端 POST /api/shutdown 关闭 Web 服务(二次确认后执行)"/>
                            <Button Content="重启后端" Style="{StaticResource DarkButton}" MinWidth="110" Margin="8,0,0,0"
                                    Command="{Binding RestartBackendCommand}"
                                    ToolTip="优雅停止本窗口托管的后端并以同端口重启(引擎重载需 10-30s; 仅托管服务可用)"/>
                            <Button Content="环境检查" Style="{StaticResource DarkButton}" MinWidth="110" Margin="8,0,0,0"
                                    Command="{Binding CheckEnvCommand}"
                                    ToolTip="运行后端 --check-env：检查资源/配置/写入权限/ADB/端口/OCR 并给出修复建议(不影响正在运行的服务)"/>
                            <Button Content="导出诊断包" Style="{StaticResource DarkButton}" MinWidth="110" Margin="8,0,0,0"
                                    Command="{Binding ExportDiagCommand}"
                                    ToolTip="导出脱敏诊断包(不含截图)：环境检查 + 配置(脱敏) + 日志尾部 + 流程清单"/>
                            <TextBlock Text="关闭服务需再次确认; 重启后端仅对本窗口托管的服务可用" Style="{StaticResource MutedText}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======== 卡片二: 识别(契约6: 回显唯一来源 /api/daily) ======== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="识别" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="记录按钮位置" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding LogClickPos, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="使用缓存位置" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding UseCachePos, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="OCR 线程数" Style="{StaticResource RowLabel}"
                                   ToolTip="每 ONNX 会话推理线程数(默认 2; 0=不限制); 改后需重启服务生效"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ThreadsBox" Width="64" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding OcrThreadsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="(0=不限制, 0~8)" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding RecogNote}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ======== 卡片二: 种植(2026-11-20: 预设选种/数量 1~360/auto/缺种购买) ======== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="种植" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选种模式" Style="{StaticResource RowLabel}"/>
                        <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                  SelectedIndex="{Binding PlantSeedModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="手动输入全称"/>
                            <ComboBoxItem Content="预设选择"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding IsPlantManual, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="种子全称" Style="{StaticResource RowLabel}"
                                   ToolTip="如 桃花 / 白色桃花 / 白色桃花种子；必须在 data/plant_presets.json 中"/>
                        <TextBox x:Name="PlantFlowerBox" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                 Style="{StaticResource DarkTextBox}"
                                 Text="{Binding PlantFlowerTypeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding IsPlantPreset, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="预设种子" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox Width="110" ItemsSource="{Binding PlantFlowers}"
                                      SelectedItem="{Binding PlantFlower, Mode=TwoWay}"/>
                            <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding PlantColors}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding PlantColor, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="数量模式" Style="{StaticResource RowLabel}"/>
                        <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left"
                                  SelectedIndex="{Binding PlantCountModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="固定数量"/>
                            <ComboBoxItem Content="自动上限 (auto)"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding IsPlantCountFixed, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="种植数量" Style="{StaticResource RowLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="PlantCountBox" Width="70" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding PlantCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="(1~360)" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding IsPlantCountFixed, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="缺种购买" Style="{StaticResource RowLabel}"
                                   ToolTip="固定模式下种子不足时去园艺店按差额购买（单批≤99，超出分批）"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding PlantBuyMissing, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3" Visibility="{Binding IsPlantCountAuto, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="auto 也开启自动购买" Style="{StaticResource RowLabel}"
                                   ToolTip="auto 不受现有种子数限制；按肥力/槽位/360 上限计算并补齐缺少量"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding PlantAutoBuy, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding PlantSeedLabel}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    <TextBlock Text="种子数据来自 data/plant_presets.json；稀有种子不可购买（购买开关会被强制关闭）。改动下次「开始一轮」生效。"
                               Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ======== 卡片三: 界面 ======== -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="界面" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="关闭窗口时弹出确认" Style="{StaticResource RowLabel}"
                                   ToolTip="契约2: 关窗确认开关; 流程运行中即使关了提醒仍强制确认"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding ConfirmPageClose, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 2026-11-19: 默认关闭; 开启后最小化才隐藏到托盘 -->
                        <TextBlock Grid.Row="1" Text="最小化时自动收进托盘" Style="{StaticResource RowLabel}"
                                   ToolTip="默认关闭: 最小化保留在任务栏; 开启后最小化隐藏到系统托盘(托盘图标不可用时自动留在任务栏)"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="截图缓存提醒阈值 (MB)" Style="{StaticResource RowLabel}"
                                   ToolTip="打开时缓存 ≥ 该阈值弹提醒; 清理只删像素, index.jsonl 墓碑永留(契约3 属 NP2)"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ThresholdBox" Width="90" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="稀有种子二次确认" Style="{StaticResource RowLabel}"
                                   ToolTip="保存种植设置与点击「开始一轮」时, 对稀有种子各确认一次"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding PlantRareConfirm, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="启用" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding UiNote}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 保存状态行(每控件改动即时保存 → 已保存 ✓); 失败显红色 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="改动即时保存, 无需手动确认"/>
                <TextBlock Text="{Binding SaveStatusText}" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveStatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
