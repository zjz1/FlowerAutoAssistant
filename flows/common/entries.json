                { "type": "sleep", "seconds": 1.0 },
                { "type": "if_text", "text": ["家族活动"], "min_score": 0.4,
                  "then": [
                    { "type": "click_text", "text": ["家族活动"], "mark": true, "delay": 1.5, "fallback_rel": [0.0773, 0.4569] }
                  ] }
              ] }
          ],
          "else": [
            { "type": "if_text", "text": ["家族"], "min_score": 0.4,
              "then": [
                { "type": "click_text", "text": ["家族"], "fallback_rel": [0.3305, 0.8264], "delay": 1.5 },
