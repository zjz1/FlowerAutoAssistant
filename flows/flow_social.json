                      "do": [
                          { "type": "click_text", "text": ["闪耀委托挑战"], "mark": true, "delay": 1.5, "fallback_rel": [0.2727, 0.8986] },
                          { "type": "loop_text",
                      "text": ["参与挑战"],
                      "min_score": 0.4,
