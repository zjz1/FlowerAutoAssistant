{
    "name": "社交任务",
    "description": "社交任务(家族活动)模块, 含两部分: ① navigate(进入家族活动) -> 摇钱树浇水(读今日 X/3, 未满浇一次并 store_fraction 记录 water_count) -> 右上角关闭; ② 闪耀委托挑战(原 flow_shine, 并入本模块, 由 config.enable_shine 控制, 默认 false): 点「闪耀委托挑战」-> loop_text(参与挑战)刷服装委托 -> 右上角关闭。",
    "steps": [
        { "type": "navigate", "target": "家族活动", "max_rounds": 3 },

        { "type": "click_rel", "rel": [0.2727, 0.4917], "delay": 2.0 },
        { "type": "if_fraction",
          "region_rel": [0.888, 0.7847],
          "condition": "a<b",
          "then": [
              { "type": "click_rel", "rel": [0.8484, 0.6875], "delay": 2.5 },
              { "type": "click_rel", "rel": [0.5, 0.9389], "delay": 2.0 },
              { "type": "store_fraction",
                "region_rel": [0.888, 0.7847],
                "key": "water_count" }
          ] },
        { "type": "click_rel",
          "rel": [0.9375, 0.125],
          "delay": 2.0 },

        { "type": "if_config",
          "key": "enable_shine",
          "value": true,
          "then": [
              { "type": "navigate", "target": "家族活动", "max_rounds": 3 },
              { "type": "click_text", "text": ["闪耀委托挑战"], "delay": 1.5, "fallback_rel": [0.2727, 0.8986] },
              { "type": "loop_text",
                "text": ["参与挑战"],
                "min_score": 0.4,
                "max_loop": 8,
                "do": [
                    { "type": "click_text", "text": ["参与挑战"], "delay": 1.8, "fallback_rel": [0.6828, 0.8181] },
                    { "type": "wait_text", "text": ["我换好了"], "timeout": 6, "interval": 1.0 },
                    { "type": "click_text", "text": ["推荐", "推荐搭配"], "delay": 1.5, "fallback_rel": [0.0523, 0.8778] },
                    { "type": "click_text", "text": ["我换好了"], "delay": 1.5, "fallback_rel": [0.2664, 0.9181] },
                    { "type": "wait_text", "text": ["确认", "确定"], "timeout": 10, "interval": 1.0 },
                    { "type": "click_text", "text": ["确认", "确定"], "delay": 1.2, "fallback_rel": [0.6383, 0.8583] },
                    { "type": "sleep", "seconds": 1.0 }
                ] },
              { "type": "click_rel", "rel": [0.9375, 0.125], "delay": 1.5 }
          ],
          "else": [] }
    ]
}