        { "type": "if_text",
          "text": ["家族首页", "家族排行", "摇钱树"],
          "min_score": 0.4,
          "then": [
              { "type": "click_rel", "rel": [0.9833, 0.0509], "delay": 2.0 }
          ] },

        { "_note": "----- 4.1.3 矿洞探险礼包（待开发，占位）-----" },
        { "type": "if_config",
