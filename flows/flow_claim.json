{
    "name": "领取奖励",
    "description": "领取奖励(含两个可用 if_config 开关): 功能1 claim_online【在线礼包】: 进面板->抽奖耗尽剩余次数->时间礼包从长到短领取->关闭; 功能2 claim_party【花灵派对】: 进花灵派对->派对时长礼包->loop_text 有'领取'就点(领完按钮消失即停)->关闭。任一开关设 false 则该功能整段跳过。",
    "steps": [
        { "type": "if_config",
          "key": "claim_online",
          "value": true,
          "then": [
              { "type": "click_rel", "rel": [0.8258, 0.2167], "delay": 1.5, "name": "在线礼包入口" },
              { "type": "loop_times",
                "times": 3,
                "do": [
                    { "type": "if_greater",
                      "region_rel": [0.6047, 0.4931],
                      "condition": "N>0",
                      "then": [
                          { "type": "click_rel", "rel": [0.6102, 0.5681], "delay": 1.0, "name": "抽奖" },
                          { "type": "wait_text", "text": ["点击任意处关闭"], "timeout": 8, "interval": 1.0 },
                          { "type": "click_rel", "rel": [0.5, 0.9375], "delay": 1.5, "name": "关闭恭喜获得" }
                      ] }
                ] },
              { "type": "count_text",
                "text": ["已领取"],
                "threshold": 3,
                "region_rel": [0.13, 0.1, 0.6, 0.9],
                "then": [],
                "else": [
                  { "type": "if_text",
                    "text": ["50分钟"],
                    "min_score": 0.5,
                    "region_rel": [0.13, 0.6, 0.25, 0.75],
                    "then": [
                        { "type": "click_rel", "rel": [0.1656, 0.6917], "delay": 1.0, "name": "领取50分钟(自动连领30/10)" },
                        { "type": "wait_text", "text": ["点击任意处关闭"], "timeout": 8, "interval": 1.0 },
                        { "type": "click_rel", "rel": [0.5, 0.9375], "delay": 1.5, "name": "关闭领取弹窗" }
                    ],
                    "else": [
                      { "type": "if_text",
                        "text": ["30分钟"],
                        "min_score": 0.5,
                        "region_rel": [0.13, 0.38, 0.25, 0.53],
                        "then": [
                            { "type": "click_rel", "rel": [0.1656, 0.4611], "delay": 1.0, "name": "领取30分钟(自动连领10)" },
                            { "type": "wait_text", "text": ["点击任意处关闭"], "timeout": 8, "interval": 1.0 },
                            { "type": "click_rel", "rel": [0.5, 0.9375], "delay": 1.5, "name": "关闭领取弹窗" }
                        ],
                        "else": [
                          { "type": "if_text",
                            "text": ["10分钟"],
                            "min_score": 0.5,
                            "region_rel": [0.13, 0.14, 0.25, 0.3],
                            "then": [
                                { "type": "click_rel", "rel": [0.1641, 0.2306], "delay": 1.0, "name": "领取10分钟" },
                                { "type": "wait_text", "text": ["点击任意处关闭"], "timeout": 8, "interval": 1.0 },
                                { "type": "click_rel", "rel": [0.5, 0.9375], "delay": 1.5, "name": "关闭领取弹窗" }
                            ] }
                        ] }
                    ] }
                ] },
              { "type": "close_dialog", "only_types": ["corner_pink_small", "corner", "corner_white"], "delay": 1.0 }
          ],
          "else": [] },
        { "type": "if_config",
          "key": "claim_party",
          "value": true,
          "then": [
              { "type": "retry_loop",
                "max_rounds": 3,
                "do": [
                    { "type": "if_text",
                      "text": ["花灵派对"],
                      "min_score": 0.4,
                      "then": [
                          { "type": "click_text", "text": ["花灵派对"], "mark": true, "delay": 1.5, "fallback_rel": [0.1859, 0.7528] },
                          { "type": "sleep", "seconds": 1.5 }
                      ],
                      "else": [
                          { "type": "if_text",
                            "text": ["菜单"],
                            "min_score": 0.4,
                            "then": [
                                { "type": "click_text", "text": ["菜单"], "delay": 1.5, "fallback_rel": [0.054, 0.081] },
                                { "type": "sleep", "seconds": 1.0 },
                                { "type": "if_text",
                                  "text": ["花灵派对"],
                                  "min_score": 0.4,
                                  "then": [
                                      { "type": "click_text", "text": ["花灵派对"], "mark": true, "delay": 1.5, "fallback_rel": [0.1859, 0.7528] }
                                  ] }
                            ],
                            "else": [
                                { "type": "if_text",
                                  "text": ["家园"],
                                  "min_score": 0.4,
                                  "then": [
                                      { "type": "click_text", "text": ["家园"], "delay": 1.5, "fallback_rel": [0.872, 0.95] },
                                      { "type": "sleep", "seconds": 1.0 },
                                      { "type": "click_text", "text": ["菜单"], "delay": 1.5, "fallback_rel": [0.054, 0.081] },
                                      { "type": "sleep", "seconds": 1.0 },
                                      { "type": "if_text",
                                        "text": ["花灵派对"],
                                        "min_score": 0.4,
                                        "then": [
                                            { "type": "click_text", "text": ["花灵派对"], "mark": true, "delay": 1.5, "fallback_rel": [0.1859, 0.7528] }
                                        ] }
                                  ] }
                            ] }
                      ] }
                ] },
              { "type": "click_rel", "rel": [0.0539, 0.4250], "delay": 1.2, "name": "派对时长礼包入口" },
              { "type": "sleep", "seconds": 1.0 },
              { "type": "loop_text",
                "text": ["领取"],
                "min_score": 0.4,
                "max_loop": 8,
                "do": [
                    { "type": "click_text", "text": ["领取"], "delay": 1.2, "fallback_rel": [0.5, 0.8333] },
                    { "type": "sleep", "seconds": 1.2 },
                    { "type": "if_text", "text": ["恭喜获得"], "min_score": 0.4,
                      "then": [ { "type": "click_rel", "rel": [0.5, 0.9375], "delay": 1.0, "name": "关闭恭喜获得" } ] }
                ] },
              { "type": "close_dialog", "anchor": "提示", "only_types": ["corner_pink_small", "corner", "corner_white"], "delay": 1.0 }
          ],
          "else": [] }
    ]
}